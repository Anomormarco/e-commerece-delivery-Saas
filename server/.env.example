DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="change-this-secret-before-deploy"
ALLOW_DEV_AUTH_HEADERS="false"

# Preferred: Resend (HTTP API, better inbox deliverability than raw Gmail SMTP).
# If RESEND_API_KEY is set, it's used instead of the SMTP_* settings below.
RESEND_API_KEY=""
RESEND_FROM="DeliverHub <onboarding@resend.dev>"

# Fallback: Gmail SMTP (used only when RESEND_API_KEY is not set).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="yourgmail@gmail.com"
SMTP_PASS="your-16-digit-app-password"
SMTP_FROM="DeliverHub <yourgmail@gmail.com>"
SMTP_SECURE="false"
SMTP_REJECT_UNAUTHORIZED="false"
