{
  "name": "@deliverhub/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode public --port 5173",
    "dev:public": "vite --host 127.0.0.1 --mode public --port 5173",
    "dev:admin": "vite --host 127.0.0.1 --mode admin --port 5174",
    "dev:store": "vite --host 127.0.0.1 --mode store --port 5175",
    "dev:courier": "vite --host 127.0.0.1 --mode courier --port 5176",
    "dev:customer": "vite --host 127.0.0.1 --mode customer --port 5177",
    "build": "tsc -b && vite build --mode public --outDir dist",
    "build:all": "tsc -b && vite build --mode public --outDir dist/public && vite build --mode admin --outDir dist/admin && vite build --mode store --outDir dist/store && vite build --mode courier --outDir dist/courier && vite build --mode customer --outDir dist/customer",
    "build:public": "tsc -b && vite build --mode public --outDir dist/public",
    "build:vercel-public": "tsc -b && vite build --mode public --outDir dist",
    "build:admin": "tsc -b && vite build --mode admin --outDir dist/admin",
    "build:store": "tsc -b && vite build --mode store --outDir dist/store",
    "build:courier": "tsc -b && vite build --mode courier --outDir dist/courier",
    "build:customer": "tsc -b && vite build --mode customer --outDir dist/customer",
    "preview:public": "vite preview --host 127.0.0.1 --port 4173 --outDir dist/public",
    "preview:admin": "vite preview --host 127.0.0.1 --port 4174 --outDir dist/admin",
    "preview:store": "vite preview --host 127.0.0.1 --port 4175 --outDir dist/store",
    "preview:courier": "vite preview --host 127.0.0.1 --port 4176 --outDir dist/courier",
    "preview:customer": "vite preview --host 127.0.0.1 --port 4177 --outDir dist/customer"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
